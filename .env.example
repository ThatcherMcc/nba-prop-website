# Neon Postgres connection string (same DB as backend)
POSTGRES_URL=

# Auth secret for POST /api/revalidate (must match backend REVALIDATE_SECRET)
REVALIDATE_SECRET=

# API key for PUT /api/update-players and /api/update-props (must match backend UPDATE_API_KEY)
UPDATE_API_KEY=

# NextAuth (Auth.js) — required for auth to work
# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Public app URL (no trailing slash) — used in redirect URLs
NEXT_PUBLIC_APP_URL=

# Plausible analytics domain (defaults to propedge.bet if unset)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=propedge.bet

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=picks@propedge.bet
